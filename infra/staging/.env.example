# Copy to /opt/smokesense/.env ON THE BOX (chmod 600) and fill in. Never commit the real .env.
# The deploy workflow never touches this file, so rotating a key is an edit here plus
# `docker compose --env-file .env --env-file image.env up -d` (or just re-run the deploy).

# Hostname Caddy serves, from `terraform output site_address`, e.g. 203-0-113-10.sslip.io
SITE_ADDRESS=

# Serve fixtures until API-03. With MOCK_MODE=false, /fires, /observations and /meta fail
# with internal_error until it lands.
MOCK_MODE=true

# Same-origin in staging, so this only matters if something else calls the API.
CORS_ALLOWED_ORIGINS=https://CHANGE-ME.sslip.io

# Neon connection string (direct endpoint, not the -pooler one: migrations need a direct
# connection). It already ends in ?sslmode=require.
DATABASE_URL=

# External data-source keys
FIRMS_MAP_KEY=
AIRNOW_API_KEY=
# NWS needs an app name plus a real contact address; the job rejects example.com and
# placeholders, so replace the whole value. PurpleAir has no live job, so no key is needed.
NWS_USER_AGENT=SmokeSense (replace-me@your-real-domain)

# Live-data retention (ingestion.live.retention, daily). Defaults shown; uncomment to change.
# Live rows older than this are deleted, which also caps Neon storage (docs/ops/staging.md).
# LIVE_RETENTION_HOURS=72
# LIVE_RETENTION_DELETE=0   # 0 = dry run, only counts what it would delete

# Model registry (read by the real predict stage, ML-04 / OPS-04). READ-ONLY key from
# docs/ops/model-registry-s3.md; never the writer key.
# REGISTRY_BACKEND=s3
# REGISTRY_S3_BUCKET=smokesense-models-<aws account id>
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Hourly forecast pipeline (OPS-04, docs/ops/forecast-pipeline.md). Real stages need the model
# registry below (REGISTRY_* and a READ-ONLY AWS key) and a promoted `baseline` version
# (python -m mlops.registry promote baseline/v2). Until then use stub/stub, otherwise the
# run fails at `predict` and /meta reports the forecast stale.
PIPELINE_FEATURES_STAGE=real
PIPELINE_PREDICT_STAGE=real
