# Copy to .env and fill in. Never commit the real .env.

# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Database (PostGIS) ---
POSTGRES_USER=smokesense
POSTGRES_PASSWORD=smokesense
POSTGRES_DB=smokesense
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- External data-source API keys ---
FIRMS_MAP_KEY=
AIRNOW_API_KEY=
PURPLEAIR_API_KEY=
NWS_USER_AGENT=SmokeSense (your-email@example.com)
