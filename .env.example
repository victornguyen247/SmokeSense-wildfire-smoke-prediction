# Copy to .env and fill in. Never commit the real .env.

# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Database (PostGIS) ---
POSTGRES_USER=smokesense
POSTGRES_PASSWORD=smokesense
POSTGRES_DB=smokesense
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Cloud Postgres (Neon etc.). Paste the connection string; leave empty to use the local DB above.
# Neon's string already ends in ?sslmode=require. Never commit the real value.
DATABASE_URL=

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- External data-source API keys ---
FIRMS_MAP_KEY=
AIRNOW_API_KEY=
PURPLEAIR_API_KEY=
NWS_USER_AGENT=SmokeSense (your-email@example.com)

# --- Model registry (docs/mlops/registry.md) ---
# local = archives in REGISTRY_LOCAL_DIR; s3 = Cloudflare R2 / any S3-compatible bucket.
# Credentials are never settings: export AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (an R2 API token).
REGISTRY_BACKEND=local
REGISTRY_LOCAL_DIR=data/registry
REGISTRY_CACHE_DIR=data/registry_cache
REGISTRY_S3_BUCKET=smoke-sense
REGISTRY_S3_PREFIX=models
REGISTRY_S3_ENDPOINT_URL=
