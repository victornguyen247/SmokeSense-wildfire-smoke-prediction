# Copy to .env and fill in. Never commit the real .env.
# Vite reads these when the dev server starts or the app is built, so restart / rebuild after a change.

# true: answer every API call in the browser with docs/api/fixtures (no backend needed).
# false: call the API at VITE_API_BASE_URL (local API-01, or staging).
VITE_USE_MOCKS=true

# Backend origin. Paths already include /api/v1.
VITE_API_BASE_URL=http://localhost:8000

# Optional: MapLibre basemap style. Defaults to OpenFreeMap Positron (free, no key).
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
