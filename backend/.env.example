# Copy to .env and fill in. Never commit the real .env.

# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Database (PostGIS) ---
POSTGRES_USER=smokesense
POSTGRES_PASSWORD=smokesense
POSTGRES_DB=smokesense
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- External data-source API keys ---
FIRMS_MAP_KEY=
AIRNOW_API_KEY=
PURPLEAIR_API_KEY=
NWS_USER_AGENT=SmokeSense (your-email@example.com)

# --- DATA-02 ingestion POC ---
FIRMS_SOURCE=VIIRS_SNPP_NRT
FIRMS_BBOX=-122.5,38.0,-120.5,39.5
FIRMS_DAY_RANGE=1
FIRMS_START_DATE=

AIRNOW_BBOX=-122.5,38.0,-120.5,39.5
AIRNOW_START_DATE=2026-09-25
AIRNOW_START_HOUR=12
AIRNOW_END_DATE=2026-09-25
AIRNOW_END_HOUR=13

# --- DATA-03 historical connectors ---
# NCEI needs no key. NCEI_STATIONS (optional) takes ICAO or NCEI IDs, e.g. KRDD,72483023232,
# and overrides the bbox.
NCEI_BBOX=-122.5,38.0,-120.5,39.5
NCEI_START_DATE=2020-09-09
NCEI_END_DATE=2020-09-10
NCEI_STATIONS=

# PurpleAir history costs points per sensor-hour; keep MAX_SENSORS small while testing.
PURPLEAIR_BBOX=-122.5,38.0,-120.5,39.5
PURPLEAIR_START_DATE=2021-08-05
PURPLEAIR_END_DATE=2021-08-05
PURPLEAIR_MAX_SENSORS=5
